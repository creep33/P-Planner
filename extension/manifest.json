{
  "manifest_version": 3,
  "name": "P-Planner",
  "version": "0.9.3",
  "description": "Per-project hour tracker with manual adjustments, synced across devices via Brave/Chrome Sync.",
  "key": "",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "P-Planner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
